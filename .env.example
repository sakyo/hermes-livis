# hermes-livis —— 全部可选。凭据本身放在 <hermes-home>/livis/ 而不是这里
# （refresh_token 会被服务端轮换，必须可写回）。

# 临时停用本渠道而不删凭据
# LIVIS_ENABLED=false

# 凭据与投递状态目录（默认 <hermes-home>/livis）
# LIVIS_STATE_DIR=/var/lib/hermes/livis

# 理想 APP 设备列表里显示的名字
# LIVIS_NODE_NAME=我的服务器

# 收口兜底窗口（毫秒）与每请求看门狗（秒）
# LIVIS_RESULT_FALLBACK_MS=5000
# LIVIS_JOB_WATCHDOG_SECONDS=300

# 本地 allowlist：填眼镜的 from_node_id（逗号分隔）。
# 留空 = 把授权委托给理想中继（默认，开箱可用）。
# LIVIS_ALLOWED_NODE_IDS=
# LIVIS_ALLOW_ALL_USERS=false

# 容器化时用 secret 注入凭据（注意 refresh_token 轮换后写不回去）
# LIVIS_REFRESH_TOKEN=
# LIVIS_AGENT_ID=
# LIVIS_DEVICE_ID=

# 握手 client 标签。默认 openclaw（中继期望的 PC 节点标识），
# 改成别的值有被服务端拒绝的风险。
# LIVIS_CLIENT_NAME=openclaw

# 端点覆盖（抓包 / 联调用）
# LIVIS_WS_URL=
# LIVIS_HTTP_URL=
# LIVIS_IDAAS_ENDPOINT=
